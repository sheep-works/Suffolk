# ==============================================================================
# Rust standard ignore files
# ==============================================================================
# ビルド生成物（中間オブジェクト、コンパイルキャッシュ、バイナリ等。数GB規模になるため必須）
/target/

# バックアップファイル
**/*.rs.bk

# Windows / MSVC デバッグシンボル
*.pdb

# ==============================================================================
# Project specific ignore files (プロジェクト固有の除外)
# ==============================================================================
# Okapi Framework 参照用コード・ZIPアーカイブ（150MB超、ライセンス・リポジトリサイズ対策）
/Okapi_ref/

# テスト・検証用データ（各種Officeファイル、HTML、JSON出力等）
/test_data/

# ==============================================================================
# OS & Editor generated files (環境・エディタ固有の生成ファイル)
# ==============================================================================
.DS_Store
Thumbs.db
desktop.ini

# エディタ設定ファイル
.vscode/
.idea/
*.swp
*~

# ログファイル
*.log
